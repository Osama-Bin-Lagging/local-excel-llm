<?xml version="1.0" encoding="UTF-8"?>
<!-- LOOOKUP: whole-workbook functions. Separate add-in from LOKUP because it needs Excel's shared runtime
     (custom functions + Excel API in one page); LOKUP stays on the plain custom-functions runtime. -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
           xsi:type="TaskPaneApp">
  <Id>d419a59c-beb4-4469-9824-63b2b58322b3</Id>
  <Version>0.2.0.0</Version>
  <ProviderName>Local</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Local LLM Workbook"/>
  <Description DefaultValue="=LOOOKUP.* — local AI that reads the whole workbook."/>
  <IconUrl DefaultValue="https://localhost:3000/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/icon-80.png"/>
  <SupportUrl DefaultValue="https://localhost:3000/workbook.html"/>
  <AppDomains>
    <AppDomain>https://localhost:3000</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="SharedRuntime" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3000/workbook.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <Runtimes>
          <Runtime resid="Workbook.Page.Url" lifetime="long"/>
        </Runtimes>
        <AllFormFactors>
          <ExtensionPoint xsi:type="CustomFunctions">
            <Script>
              <SourceLocation resid="Workbook.Script.Url"/>
            </Script>
            <Page>
              <SourceLocation resid="Workbook.Page.Url"/>
            </Page>
            <Metadata>
              <SourceLocation resid="Workbook.Metadata.Url"/>
            </Metadata>
            <Namespace resid="Workbook.Namespace"/>
          </ExtensionPoint>
        </AllFormFactors>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.32x32" DefaultValue="https://localhost:3000/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://localhost:3000/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Workbook.Script.Url" DefaultValue="https://localhost:3000/workbook-functions.js"/>
        <bt:Url id="Workbook.Metadata.Url" DefaultValue="https://localhost:3000/workbook-functions.json"/>
        <bt:Url id="Workbook.Page.Url" DefaultValue="https://localhost:3000/workbook.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Workbook.Namespace" DefaultValue="LOOOKUP"/>
      </bt:ShortStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
